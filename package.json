{
  "name": "a-news-x-api-key",
  "version": "2.0.0",
  "description": "Full-stack NewsApp powered by Node.js and the GNews API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --pretty",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "start:test": "cross-env NODE_ENV=test PORT=4173 node dist/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "PWDEBUG=1 playwright test",
    "test:backend": "npm run build && node --test tests/backend",
    "pretest": "npm run build"
  },
  "keywords": [
    "news",
    "nodejs",
    "express",
    "gnews"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "http-errors": "^2.0.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^18.19.127",
    "axios-mock-adapter": "^1.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
